DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:../dev.db"
DIRECT_URL="postgresql://user:password@localhost:5432/docforge"
STORAGE_PROVIDER="local"

# For production, set DATABASE_PROVIDER=postgresql, use a pooled Neon URL for
# DATABASE_URL, and use Neon’s direct (non-pooled) URL for DIRECT_URL.
# Set STORAGE_PROVIDER=vercel-blob and configure the Vercel Blob store.
# BLOB_READ_WRITE_TOKEN is only needed for local runs outside Vercel OIDC.

# Seed-time values. Set all passwords in the shell before running npm run db:seed.
ADMIN_EMAIL="admin@example.test"
AUTHOR_EMAIL="author@example.test"
REVIEWER_EMAIL="reviewer@example.test"
PUBLISHER_EMAIL="publisher@example.test"
VIEWER_EMAIL="customer@example.test"
